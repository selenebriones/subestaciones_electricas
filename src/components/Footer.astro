---
<footer id="footer" class="footer">
  <div class="footer-container">
    <div class="footer-form scroll-trigger">
      <h2>¿Listo para arrancar tu proyecto eléctrico?</h2>
      <form id="contact-form">
        <input type="hidden" id="origen" name="origen" />
        <div class="input-group">
          <input type="text" id="name" required placeholder=" ">
          <label for="name">Nombre Completo</label>
        </div>

        <div class="input-group">
          <input type="tel" id="phone" required placeholder=" ">
          <label for="phone">Teléfono</label>
        </div>
        <div class="input-group">
          <input type="email" id="email" required placeholder=" ">
          <label for="email">Correo Electrónico</label>
        </div>
        <div class="input-group">
          <textarea id="comments" required placeholder=" " rows="4"></textarea>
          <label for="comments">Comentarios</label>
        </div>
        <button type="submit" class="btn btn-submit" id="submit-btn">
          <span class="btn-text">Enviar Requerimiento Técnico</span>
          <span class="btn-loader"></span>
        </button>
      </form>
    </div>
    <div class="footer-info scroll-trigger delay-1">

      <div class="info-block">
        <h3>Teléfono de ventas / atención 24 hrs</h3>
        <p style="font-size: 1.5rem; font-weight: 700; color: white;">Cel: + 52 656 268 9513</p>
        <h3 style="margin-top: 16px;">Email</h3>
        <p style="font-size: 1.4rem; font-weight: 700; color: white;">ingenierodanielgarza@gmail.com</p>
      </div>

      <div class="footer-links">
        <div style="display: flex; align-items: center; gap: 16px;">
          <a href="#">&copy; 2026 Subestaciones. Todos los derechos reservados.</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const form = document.getElementById('contact-form');
  const origenInput = document.getElementById('origen');
  const phoneInput = document.getElementById('phone');

  if (phoneInput) {
    // Evita que se puedan escribir letras o símbolos, forzando solo números en tiempo real
    phoneInput.addEventListener('input', function() {
      this.value = this.value.replace(/[^0-9]/g, '');
    });
  }

  if (form && origenInput) {
    // Llenar dinámicamente el origen
    origenInput.value = window.location.href;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = document.getElementById('name').value;
      const phone = document.getElementById('phone').value;
      const email = document.getElementById('email').value;
      const comments = document.getElementById('comments').value;
      const origen = origenInput.value;

      // Validación simple adicional (los atributos required ya hacen gran parte del trabajo)
      if (!name || !phone || !email || !comments) {
        alert('Por favor, completa todos los campos requeridos.');
        return;
      }

      // Validación de teléfono (estricta: solo números, mínimo 10 dígitos)
      const phoneRegex = /^[0-9]{10,}$/;
      if (!phoneRegex.test(phone)) {
        alert('Por favor, ingresa un número de teléfono válido (solo números, mínimo 10 dígitos).');
        return;
      }

      // Validación de email (debe contener @ y formato de correo)
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email) || !email.includes('@')) {
        alert('Por favor, ingresa un correo electrónico válido (ejemplo: usuario@dominio.com).');
        return;
      }

      const btn = document.getElementById('submit-btn');
      const btnText = btn.querySelector('.btn-text');
      const originalText = btnText.textContent;

      btnText.textContent = 'Enviando...';
      btn.disabled = true;

      try {
        const response = await fetch('https://n8n.ongoing.mx/webhook/a25ee2dc-cc72-4526-84c5-cda3144eb14f', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'subestaciones': 'Huo0lpaw.'
          },
          body: JSON.stringify({
            name,
            phone,
            email,
            comments,
            origen
          })
        });

        if (response.ok) {
          window.location.href = '/gracias';
        } else {
          alert('Hubo un error al enviar el formulario. Intenta nuevamente.');
          btnText.textContent = originalText;
          btn.disabled = false;
        }
      } catch (error) {
        alert('Ocurrió un error de red. Revisa tu conexión e intenta de nuevo.');
        btnText.textContent = originalText;
        btn.disabled = false;
      }
    });
  }
</script>
