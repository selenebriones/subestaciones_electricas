---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="Subestaciones Eléctricas Llave en Mano para la Industria. Diseño, suministro, instalación y trámites completos ante CFE." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Montserrat:wght@700;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
    
    <script>
      // Global Scripts that need to run across the layout
      import '../scripts/main.js';
    </script>
    
    <!-- Chatbot Script -->
    <script src="https://conversia.com.mx/assets/js/chatbot.js" id="chatbot-js" is:inline></script>
    <script is:inline>
        CHATKODEX.init({
            host: window.location.host,
            key: "blJYqbDCaEAfr"
        });
    </script>
  </body>
</html>
